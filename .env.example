# Copy to .env (gitignored) and fill in. Never commit real values.

# MySQL (Amazon RDS)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=music_review_app
# Optional: true encrypts the connection to RDS (TLS). Set to true on Render.
# DB_SSL=true

# Signs the session cookie. Required in production; any long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional
# Contact (email or URL) sent in the MusicBrainz User-Agent header, as MusicBrainz
# requests. Defaults to the project's GitHub URL.
# MUSICBRAINZ_CONTACT=you@example.com
# PORT=4000
# NODE_ENV=production

# Optional: AI recommendations and listening summaries (features #13, #14).
# Free Google Gemini key from https://aistudio.google.com/apikey (no card needed).
# Without a key TuneBoxd still recommends music and writes summaries using its
# own rules; with one, Gemini writes the explanations. Never commit the key.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
