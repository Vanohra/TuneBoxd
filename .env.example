# Copy to .env (gitignored) and fill in. Never commit real values.

# MySQL (Amazon RDS)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=music_review_app

# Signs the session cookie. Required in production; any long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional
# PORT=4000
# NODE_ENV=production
